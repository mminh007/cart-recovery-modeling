# ==============================================================================
# Environment Configuration — Cart Abandonment Modeling & Fine-tune (Repo 1)
# Copy this file to .env and fill in values before running Docker or scripts.
# ==============================================================================

# --- Storage Backend ("local" | "s3" | "gcs") ---
STORAGE_BACKEND=local
DATA_ROOT=./data
# S3 / MinIO (Phase 2 Cloud Migration)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
S3_BUCKET_URI=s3://cart-abandonment-datalake
# GCS (Phase 2 Cloud Migration)
GCS_BUCKET_URI=gs://cart-abandonment-datalake

# --- Kaggle API Credentials (for dataset ingestion) ---
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- MLflow Tracking & Registry ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_ROOT=./mlartifacts
MLFLOW_EXPERIMENT_PREFIX=cart-abandon

# --- Airflow Configuration ---
AIRFLOW_UID=50000
AIRFLOW__CORE__LOAD_EXAMPLES=False
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# --- LLM Synthetic Data & Fine-tuning ---
GEMINI_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
WANDB_API_KEY=
